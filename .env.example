# ═══════════════════════════════════════════════════════════════
#  AuthKit Environment Variables
#  Copy this file to .env and fill in all required values.
#  Lines marked [REQUIRED] must be set before running the app.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database [REQUIRED] ─────────────────────────────────────────
# PostgreSQL connection URL
DATABASE_URL="postgresql://authkit:authkit_pass@localhost:5432/authkit?schema=public"

# ── Redis [REQUIRED] ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT [REQUIRED] ──────────────────────────────────────────────
# For HS256 (dev): any random string (min 32 chars)
JWT_SECRET="change-me-to-a-very-long-random-secret-in-production"

# For RS256 (recommended in prod): leave JWT_SECRET blank and
# place your PEM files at ./keys/private.pem and ./keys/public.pem
# Generate with: npm run keys:generate

JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_ISSUER="authkit"
JWT_AUDIENCE="authkit-clients"

# ── Email ───────────────────────────────────────────────────────
# Provider: "smtp" | "sendgrid" | "resend"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="AuthKit <noreply@authkit.dev>"

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/google/callback"

# ── GitHub OAuth ────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/github/callback"

# ── Frontend (admin redirect) ───────────────────────────────────
FRONTEND_URL="http://localhost:3001"

# ── Security ────────────────────────────────────────────────────
# Number of failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5
# Lock duration in minutes
LOCKOUT_DURATION_MINUTES=30
# Bcrypt/Argon2 cost factor (higher = slower = more secure)
HASH_MEMORY_COST=65536
HASH_TIME_COST=3

# ── Seeding ─────────────────────────────────────────────────────
# Override these to change the default superadmin credentials
SEED_ADMIN_EMAIL="admin@authkit.dev"
SEED_ADMIN_PASSWORD="Admin@AuthKit2025!"

# ── HaveIBeenPwned ──────────────────────────────────────────────
# Optional: checks passwords against known breached lists
HIBP_API_KEY=""

# ── Admin Dashboard ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
