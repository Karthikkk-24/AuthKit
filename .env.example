# ═══════════════════════════════════════════════════════════════
#  AuthKit Environment Variables
#  Copy this file to .env and fill in all required values.
#  Lines marked [REQUIRED] must be set before running the app.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database [REQUIRED] ─────────────────────────────────────────
# PostgreSQL connection URL
DATABASE_URL="postgresql://authkit:authkit_pass@localhost:5432/authkit?schema=public"

# ── Redis [REQUIRED] ────────────────────────────────────────────
# Include password when using docker-compose (see REDIS_PASSWORD).
REDIS_URL="redis://:authkit_redis_dev_only@localhost:6379"
REDIS_PASSWORD="authkit_redis_dev_only"

# ── Database password (docker-compose) ──────────────────────────
POSTGRES_PASSWORD="authkit_dev_only_change_me"

# ── JWT [REQUIRED] ──────────────────────────────────────────────
# NEVER use a hardcoded/shared default secret. AuthKit refuses to boot
# in production without real key material (set AUTHKIT_STRICT_JWT=true to
# enforce the same locally).
#
# For RS256 (recommended): run `npm run keys:generate` and keep
# ./keys/private.pem + ./keys/public.pem out of git.
# authkit.config.json defaults to algorithm "RS256".
#
# For HS256 only: set a strong secret (min 32 chars) and change config
# algorithm to "HS256".
JWT_SECRET=""
AUTHKIT_STRICT_JWT=false

JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_ISSUER="authkit"
JWT_AUDIENCE="authkit-clients"

# ── Email ───────────────────────────────────────────────────────
# email.enabled stays false in authkit.config.json by default so local
# boots never depend on SMTP. To send real mail:
#   1. Set email.enabled=true in authkit.config.json (or Admin → Settings)
#   2. Choose provider below and fill credentials
# Provider: "smtp" | "sendgrid" | "resend"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="AuthKit <noreply@authkit.dev>"

# Local catch-all (MailHog) — start with:
#   docker compose --profile dev up mailhog -d
# Then point SMTP at MailHog and enable email in config:
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_USER=  SMTP_PASSWORD=
# UI: http://localhost:8025

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/google/callback"

# ── GitHub OAuth ────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/oauth/github/callback"

# ── Frontend (admin redirect) ───────────────────────────────────
FRONTEND_URL="http://localhost:3001"

# ── Security ────────────────────────────────────────────────────
# Number of failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5
# Lock duration in minutes
LOCKOUT_DURATION_MINUTES=30
# Bcrypt/Argon2 cost factor (higher = slower = more secure)
HASH_MEMORY_COST=65536
HASH_TIME_COST=3

# ── Seeding ─────────────────────────────────────────────────────
# Override these to change the default superadmin credentials
# ── Seed admin (db:seed) ────────────────────────────────────────
# Local DX may omit SEED_ADMIN_PASSWORD (warns and uses a published default).
# Production seed REFUSES to run without a unique SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL="admin@authkit.dev"
SEED_ADMIN_PASSWORD=""

# ── HaveIBeenPwned ──────────────────────────────────────────────
# Optional: checks passwords against known breached lists (k-anonymity range API).
# Enable in authkit.config.json:
#   features.pwnedPasswordCheck=true
#   auth.password.checkPwnedPasswords=true
# No API key is required for the public range endpoint; HIBP_API_KEY is reserved
# for future authenticated tiers.
HIBP_API_KEY=""

# ── Crypto / MFA at rest ───────────────────────────────────────
# 64-char hex (32 bytes). Required in production for TOTP secret encryption.
# Generate: openssl rand -hex 32
AUTHKIT_SECRET_KEY=""

# ── Proxy / IP controls (#96) ──────────────────────────────────
# Set to 1 (or hop count) when behind Nginx/ALB/Cloudflare so req.ip is the client.
# Do not enable without a real reverse proxy — clients can spoof X-Forwarded-For.
TRUST_PROXY=""

# Redis blacklist: fail closed outside production when set
# AUTHKIT_STRICT_REDIS=true
# AUTHKIT_REDIS_FAIL_CLOSED=true
# AUTHKIT_REDIS_FAIL_OPEN=true   # force fail-open (local DX only)

# ── Observability ───────────────────────────────────────────────
# In production, GET /api/v1/metrics/prometheus returns 401 unless true.
# Prefer network ACL + PROMETHEUS_PUBLIC, or scrape /metrics/prometheus/secure with admin JWT.
PROMETHEUS_PUBLIC=""

# ── Admin Dashboard ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
