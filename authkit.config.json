{
  "app": {
    "name": "AuthKit",
    "port": 3000,
    "environment": "development",
    "apiPrefix": "api",
    "adminPath": "/admin"
  },

  "database": {
    "orm": "prisma",
    "url": "${DATABASE_URL}"
  },

  "auth": {
    "strategies": {
      "local": { "enabled": true },
      "google": {
        "enabled": false,
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "callbackUrl": "http://localhost:3000/api/v1/auth/google/callback"
      },
      "github": {
        "enabled": false,
        "clientId": "${GITHUB_CLIENT_ID}",
        "clientSecret": "${GITHUB_CLIENT_SECRET}",
        "callbackUrl": "http://localhost:3000/api/v1/auth/github/callback"
      },
      "magicLink": { "enabled": false },
      "apiKey": { "enabled": true }
    },

    "jwt": {
      "algorithm": "RS256",
      "accessTokenExpiry": "15m",
      "refreshTokenExpiry": "7d",
      "issuer": "authkit",
      "audience": "authkit-clients"
    },

    "password": {
      "hashingAlgorithm": "argon2id",
      "minLength": 8,
      "maxLength": 128,
      "requireUppercase": true,
      "requireLowercase": true,
      "requireNumbers": true,
      "requireSpecialChars": true,
      "checkPwnedPasswords": false
    },

    "registration": {
      "enabled": true,
      "requireEmailVerification": true,
      "defaultRole": "user",
      "allowedDomains": []
    }
  },

  "mfa": {
    "enabled": true,
    "required": false,
    "requiredForRoles": ["admin", "superadmin"],
    "methods": ["totp", "email"],
    "backupCodesCount": 10,
    "totpIssuer": "AuthKit"
  },

  "security": {
    "rateLimit": {
      "enabled": true,
      "global": { "windowMs": 60000, "max": 200 },
      "login": { "windowMs": 900000, "max": 5 },
      "register": { "windowMs": 3600000, "max": 10 },
      "passwordReset": { "windowMs": 3600000, "max": 3 }
    },
    "accountLockout": {
      "enabled": true,
      "maxAttempts": 5,
      "lockDurationMinutes": 30,
      "progressiveDelay": true
    },
    "cors": {
      "enabled": true,
      "origins": ["http://localhost:3001"],
      "credentials": true
    },
    "helmet": { "enabled": true },
    "ipAllowlist": [],
    "ipBlocklist": []
  },

  "session": {
    "maxConcurrentSessions": 5,
    "trackDevices": true,
    "autoRevokeInactiveSessions": true,
    "inactivityTimeoutDays": 30
  },

  "email": {
    "enabled": false,
    "provider": "smtp",
    "from": "noreply@authkit.dev",
    "fromName": "AuthKit",
    "smtp": {
      "host": "${SMTP_HOST}",
      "port": 587,
      "secure": false,
      "user": "${SMTP_USER}",
      "password": "${SMTP_PASSWORD}"
    },
    "sendgrid": {
      "apiKey": "${SENDGRID_API_KEY}"
    },
    "resend": {
      "apiKey": "${RESEND_API_KEY}"
    },
    "templates": {
      "branding": {
        "logo": "",
        "primaryColor": "#6366f1",
        "companyName": "AuthKit"
      }
    }
  },

  "redis": {
    "url": "${REDIS_URL}",
    "prefix": "authkit:"
  },

  "audit": {
    "enabled": true,
    "logSuccessfulLogins": true,
    "logFailedLogins": true,
    "logTokenRefresh": false,
    "retentionDays": 90,
    "sensitiveFieldsToRedact": ["password", "token", "secret", "refreshToken", "accessToken"]
  },

  "webhooks": {
    "enabled": false,
    "timeout": 5000,
    "retries": 3
  },

  "ui": {
    "enabled": true,
    "theme": "midnight",
    "availableThemes": ["midnight", "aurora", "slate", "ember", "arctic"],
    "showSwaggerDocs": true
  },

  "features": {
    "registration": true,
    "emailVerification": true,
    "passwordReset": true,
    "magicLink": false,
    "mfa": true,
    "apiKeys": true,
    "webhooks": false,
    "adminImpersonation": false,
    "gdprTools": true,
    "pwnedPasswordCheck": false
  }
}
